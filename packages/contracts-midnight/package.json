{
  "name": "@solana-anonboard/contracts-midnight",
  "version": "1.0.0",
  "private": true,
  "exports": {},
  "scripts": {
    "midnight-proof-server:start": "RUST_BACKTRACE=full SUBSTRATE_NODE_WS_URL=\"${SUBSTRATE_NODE_WS_URL:-ws://localhost:9944}\" bun ../../node_modules/.bin/npm-midnight-proof-server",
    "midnight-proof-server:wait": "bun ../../node_modules/.bin/wait-on tcp:6300",
    "midnight-indexer-proxy:wait": "bun ../../node_modules/.bin/wait-on tcp:${INDEXER_PROXY_PORT}",
    "midnight-contract:clean": "rm -rf midnight-level-db && rm -f contract.json contract-anonboard.undeployed.json",
    "midnight-contract:deploy": "bun run ensure-deployed.ts"
  },
  "dependencies": {
    "@effectstream/npm-midnight-proof-server": "0.102.0",
    "@effectstream/midnight-contracts": "0.102.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  }
}
