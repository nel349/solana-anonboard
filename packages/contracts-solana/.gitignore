# Rust/SBF build artifacts
programs/anonboard/target/

# Compiled program output — built on demand, never committed. `bun run dev` runs
# the build-anonboard step before the validator; `bun run build:solana` rebuilds it
# after editing programs/anonboard/src/lib.rs. (cargo-build-sbf ships in
# @effectstream/solana-node's vendor/ dir, populated when the node binary downloads.)
/build/

# solana-test-validator scratch ledger
test-ledger/

# rustfmt backups
**/*.rs.bk

# Keypairs. `keypair/anonboard-program.json` IS committed on purpose so the
# program ID stays deterministic for local dev — its secret is public and it
# must never own anything on a real network. Any OTHER keypair stays out.
keypair/*.json
!keypair/anonboard-program.json
