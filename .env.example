# Copy to .env.preview / .env.preprod and fill in for a hosted TestNet run.
# These hold private keys — they are gitignored; NEVER commit real values.
# Run with: bun run dev:preview  (or dev:preprod)

MIDNIGHT_NETWORK_ID=preview                       # or preprod
MIDNIGHT_WALLET_SEED=<64-hex funded wallet seed>  # a wallet funded (NIGHT + dust) on that net
MIDNIGHT_OWNER_KEY=<64-hex private owner key>     # roster admin (gates add_to_roster)
