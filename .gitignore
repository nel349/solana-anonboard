node_modules/

# Compiled Compact output (regenerated by `midnight-contract-compile` on boot)
**/managed/

# Solana program build output
build/

# Generated ZK artifacts served to the browser (copied from managed/ by copy-zk)
packages/frontend/public/anonboard/

# Runtime LevelDB state (regenerated each boot) — patterns must match the
# real dir name `midnight-level-db-deploy`, at root AND nested.
**/midnight-level-db-deploy/
midnight-level-db/

# Persistent localnet chain data (Midnight node base-path + indexer SQLite).
# Kept across restarts so a funded/dust-registered wallet + the deployed
# contract survive. Wipe with `bun run midnight:reset` for a clean chain.
# NOTE: dev-spec.json (the funded genesis) is COMMITTED — do not ignore it.
.midnight-data/

# Runtime / dev artifacts
*.log
logs/
batcher-data/
poster.json
contract-anonboard.*.json
contract.json
badge.json
.DS_Store
